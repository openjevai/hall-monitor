# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

# Hall Monitor reads these from the process environment (it doesn't load .env):
# set them in your shell, or with `setx` on Windows. install.py writes only a ${env:TYPESAFE_API_KEY} reference.
# TypeSafe API key for Jev (required)
TYPESAFE_API_KEY=your_typesafe_key_here_DO_NOT_COMMIT
# OpenJEV (optional community gateway to the same Jev model, see OPENJEV.md)
OPENJEV_API_KEY=your_openjev_key_here_DO_NOT_COMMIT
# Set JEV_PROVIDER=openjev to force OpenJEV even when TYPESAFE_API_KEY is set
# JEV_PROVIDER=openjev
# IBM Bob Shell key (for `bob run`, scripts/headless.py and the auditor mode)
BOB_API_KEY=your_bob_key_here_DO_NOT_COMMIT


# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================